{
  "name": "toolbox",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test && node --test scripts/*.test.mjs",
    "test:browser": "pnpm -r --if-present run test:browser",
    "check:privacy": "node scripts/check-privacy.mjs",
    "gen:zh-hant": "node scripts/gen-zh-hant.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:audit": "pnpm audit --prod --audit-level high",
    "deploy": "bash deploy/deploy.sh",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "shots": "node scripts/capture-screens.mjs docs/screenshots"
  },
  "devDependencies": {
    "opencc-js": "^1.0.5",
    "playwright": "^1.61.0",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
